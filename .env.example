# Copy this file to .env (never commit the real .env) and fill the values.
# Client (Vite) variables MUST start with VITE_

# Google Sign-In
GOOGLE_CLIENT_ID=your-google-client-id
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Session / Security
SESSION_SECRET=change-me-to-a-long-random-string

# Access control (comma separated, leave empty to allow all)
ALLOWED_EMAILS=foo@gmail.com,bar@gmail.com
VITE_ALLOWED_EMAILS=foo@gmail.com,bar@gmail.com

# Turso / libSQL
TURSO_DATABASE_URL=libsql://your-host
TURSO_DB_AUTH_TOKEN=your-turso-auth-token

# Optional CORS origins (comma separated) used only if API and frontend are on different domains
CORS_ORIGIN=https://example.com,https://admin.example.com

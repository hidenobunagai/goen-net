# Next.js + NextAuth + Turso 用環境変数サンプル
# 実際の値は .env.local に設定してください

# ==========================================
# Next.js & NextAuth (必須)
# ==========================================
NEXTAUTH_URL="https://yourdomain.com"
# 最低32文字のランダム文字列を生成してください
# 生成方法: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-at-least-32-characters-long-change-this"

# ==========================================
# Google OAuth (必須)
# ==========================================
# Google Cloud Console で OAuth 2.0 クライアント ID を作成してください
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ==========================================
# アクセス制御 (オプション)
# ==========================================
# カンマ区切りまたはスペース区切りで許可するメールアドレスを指定
# 未設定の場合は全てのGoogleアカウントをブロック（サインイン不可）
ALLOWED_EMAILS="user1@example.com,user2@example.com,user3@example.com"

# ==========================================
# Turso Database (必須 - 本番環境)
# ==========================================
# Turso CLI で作成したデータベースの URL
TURSO_DB_URL="libsql://your-database-name.turso.io"
# または TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
# または DATABASE_URL="libsql://your-database-name.turso.io"

# Turso データベースの認証トークン
TURSO_DB_AUTH_TOKEN="your-turso-auth-token"
# または TURSO_AUTH_TOKEN="your-turso-auth-token"
# または LIBSQL_AUTH_TOKEN="your-turso-auth-token"

# ==========================================
# メール送信 (オプション - Resend.com)
# ==========================================
# セッションリマインダー等のメール送信に使用
# https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Goen Net <noreply@yourdomain.com>"

# ==========================================
# Cron認証 (オプション - Vercel Cron)
# ==========================================
# Vercel Cron からのリクエストを検証するシークレット
CRON_SECRET="your-random-cron-secret"

# ==========================================
# 開発・デバッグ用オプション
# ==========================================
# データベースを使わずメモリ内で動作（開発・テスト用）
# DEGRADE_TO_MEMORY="1"

# Node.js環境（自動設定されるため通常は不要）
# NODE_ENV="development"

############################################################
# Clean .gitignore
# Purpose: Exclude dependencies, build outputs, secrets, temp, tooling
############################################################

# Node dependencies
node_modules/

# Integration reference files (not part of application)
GoenNetFork/

# Build / Output
dist/
dist-ssr/
.vercel/
.next/
out/

# Environment & Secrets
.env
.env.*
!.env.example
secret*.json
turso-db.json
turso-db-token.json

# Databases / ORM / Prisma
.prisma/
prisma/client/
*.db
*.sqlite

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
.pnpm-debug.log*

# TypeScript build info
*.tsbuildinfo

# Local overrides & temp files
\.claude
*.local.*
*.swp
*.tmp
*.orig
tmp-*.js

# Package manager artifacts
/.pnp
.pnp.*
.yarn/

# IDE / Editor / OS
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Internal tooling artifacts
.serena/

# Coverage
coverage/

# Next.js generated types
next-env.d.ts

# (Optional) generated code placeholder
# src/generated/

############################################################
.vercel
.env*.local
# Added by code-review-graph
.code-review-graph/

# Test artifacts
test-results/
playwright-report/

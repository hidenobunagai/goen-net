    "@emotion/styled": "^11.11.3",
    "@libsql/client": "^0.15.15",
    "@mui/icons-material": "^5.15.20",
    "@mui/material": "^5.15.20",
    "@mui/material-nextjs": "^7.3.3",
    "@tanstack/react-query": "^5.90.5",
    "@vercel/analytics": "^1.5.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "next": "^16.0.7",
    "next-auth": "^4.24.12",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^4.1.12"
